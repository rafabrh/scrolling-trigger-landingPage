# NEXT_PUBLIC_SITE_URL
# Origem absoluta do site (protocolo + host, sem barra final). É a fonte de
# verdade para canonical, og:url, metadataBase, sitemap.xml, robots.txt e o
# JSON-LD Organization.
# OBRIGATÓRIA em produção. Se não definida, o app cai no fallback
# 'https://shkgroup.com.br' (o domínio de produção) — por isso um deploy de
# preview que esqueça de setar herda a URL de produção. A indexação, porém, é
# controlada separadamente pelo sinal VERCEL_ENV (ver src/lib/env/deploy.ts).
NEXT_PUBLIC_SITE_URL=https://shkgroup.com.br

# NEXT_PUBLIC_SHARKNEWS_SUBSCRIBE_URL
# Endpoint da API de inscrição na newsletter SharkNews.
# Fallback: https://sharknews-sub.com.br/api/subscribe
# NEXT_PUBLIC_SHARKNEWS_SUBSCRIBE_URL=https://sharknews-sub.com.br/api/subscribe

# NEXT_PUBLIC_SHARKNEWS_API_KEY
# Token de admin para a API da SharkNews. Enviado como header X-Admin-Token.
# Exposto no bundle do cliente (NEXT_PUBLIC_) — não use segredos sensíveis aqui.
# O ideal futuro é mover esta chamada para uma API route server-side.
# NEXT_PUBLIC_SHARKNEWS_API_KEY=

# NEXT_PUBLIC_CAPI_WEBHOOK_URL
# Webhook do N8N para envio de leads via Conversions API (fire-and-forget).
# Fallback: https://n8n.shkgroups.com/webhook/capi-lead
# NEXT_PUBLIC_CAPI_WEBHOOK_URL=https://n8n.shkgroups.com/webhook/capi-lead
